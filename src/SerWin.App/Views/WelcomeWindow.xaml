<ui:FluentWindow x:Class="SerWin.App.Views.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:SerWin.App.Localization"
                 Width="680" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style x:Key="ProfileButton" TargetType="ui:Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar ShowMinimize="False" ShowMaximize="False" ShowClose="False" />
        <StackPanel Margin="32,0,32,28">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{loc:T Welcome_Title}" />
            <TextBlock Margin="0,8,0,4" FontSize="14" TextWrapping="Wrap" Text="{loc:T Welcome_Intro}" />
            <TextBlock Margin="0,0,0,18" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:T Welcome_Privacy}" />
            <TextBlock Margin="0,0,0,10" FontSize="16" FontWeight="SemiBold" Text="{loc:T Welcome_Question}" />

            <ui:Button Style="{StaticResource ProfileButton}" Tag="Simple" Click="OnChoose">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:T Welcome_Curious}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8" Text="{loc:T Welcome_CuriousHelp}" />
                </StackPanel>
            </ui:Button>
            <ui:Button Style="{StaticResource ProfileButton}" Tag="Avance" Click="OnChoose">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:T Welcome_Tinkerer}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8" Text="{loc:T Welcome_TinkererHelp}" />
                </StackPanel>
            </ui:Button>
            <ui:Button Style="{StaticResource ProfileButton}" Tag="Expert" Click="OnChoose">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{loc:T Welcome_Expert}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Opacity="0.8" Text="{loc:T Welcome_ExpertHelp}" />
                </StackPanel>
            </ui:Button>
            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{loc:T Welcome_ChangeLater}" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
